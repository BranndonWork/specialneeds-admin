# Test Environment Configuration
# Port 3001 to avoid conflicts with dev server on 3000

NODE_ENV=test
NEXT_PUBLIC_PORT=3001
NEXT_PUBLIC_HOST=localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# API_ENDPOINT=https://devapi.specialneeds.com

# Feature flags
NEXT_PUBLIC_CHAT_ENABLED=false
NEXT_PUBLIC_LISTING_REVIEWS_ENABLED=true
NEXT_PUBLIC_NOTIFICATIONS_ENABLED=false
NEXT_PUBLIC_COMMENTS_ENABLED=true

# Algolia/Meilise Search (use dev environment)
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=

# WebSocket
NEXT_PUBLIC_SOCKET_URL=ws://localhost:3001

# Meilisearch
NEXT_PUBLIC_MEILISEARCH_HOST=search.specialneeds.com

# API and Security
API_ENDPOINT=https://api.specialneeds.com

