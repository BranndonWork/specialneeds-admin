{
    "name": "specialneeds",
    "proxy": "https://nominatim.openstreetmap.org",
    "version": "0.1.2",
    "private": true,
    "scripts": {
        "dev": "next dev -p $NEXT_PUBLIC_PORT",
        "staging": "next start -p $NEXT_PUBLIC_PORT",
        "production": "next start -p $NEXT_PUBLIC_PORT",
        "start": "next start -p $NEXT_PUBLIC_PORT",
        "build": "next build",
        "lint": "next lint",
        "test:e2e": "playwright test --config=e2e/playwright.config.js",
        "test:e2e:headed": "playwright test --config=e2e/playwright.config.js --headed",
        "test:e2e:ui": "playwright test --config=e2e/playwright.config.js --ui",
        "test:e2e:debug": "playwright test --config=e2e/playwright.config.js --debug",
        "test:e2e:smoke": "playwright test --config=e2e/playwright.config.js smoke",
        "test:e2e:critical": "playwright test --config=e2e/playwright.config.js critical",
        "test:e2e:regression": "playwright test --config=e2e/playwright.config.js regression",
        "test:e2e:staging": "playwright test --config=e2e/playwright.staging.config.js",
        "test:e2e:prod": "playwright test --config=e2e/playwright.prod.config.js --grep @smoke",
        "test:e2e:codegen": "playwright codegen --config=e2e/playwright.config.js http://localhost:3001",
        "test:e2e:report": "playwright show-report playwright-report",
        "test:e2e:install": "playwright install --with-deps",
        "postbuild": "next-sitemap",
        "test": "jest",
        "test:watch": "jest --watch"
    },
    "dependencies": {
        "@emotion/css": "^11.10.6",
        "@emotion/react": "^11.10.6",
        "@emotion/styled": "^11.10.6",
        "@mantine/core": "^5.10.5",
        "@mantine/hooks": "^5.10.5",
        "@mantine/rte": "^5.10.5",
        "@material-ui/core": "^4.12.4",
        "@material-ui/icons": "^4.11.3",
        "@meilisearch/instant-meilisearch": "^0.28.0",
        "@mui/icons-material": "^5.11.16",
        "@mui/lab": "^5.0.0-alpha.127",
        "@mui/material": "^5.12.1",
        "@mui/styles": "^5.12.0",
        "@mui/x-data-grid": "^6.2.1",
        "@refinedev/core": "^5.0.12",
        "@refinedev/nextjs-router": "^7.0.5",
        "@refinedev/simple-rest": "^6.0.1",
        "@tiptap/extension-link": "^3.22.3",
        "@tiptap/pm": "^3.22.3",
        "@tiptap/react": "^3.22.3",
        "@tiptap/starter-kit": "^3.22.3",
        "algoliasearch": "^4.19.1",
        "altcha": "^2.3.0",
        "altcha-lib": "^1.4.1",
        "autolinker": "^4.1.5",
        "axios": "^0.21.4",
        "dompurify": "^3.0.8",
        "dotenv": "^16.3.1",
        "escape-html": "^1.0.3",
        "fslightbox-react": "^1.7.4",
        "ioredis": "^5.9.3",
        "js-cookie": "^2.2.1",
        "lightgallery": "^2.7.2",
        "meilisearch": "^0.53.0",
        "moment": "^2.29.4",
        "moment-timezone": "^0.6.0",
        "next": "^14.2.0",
        "next-intl": "^4.8.2",
        "nominatim-browser": "^2.1.0",
        "nprogress": "^0.2.0",
        "react": "^18.2.0",
        "react-bootstrap": "^1.6.6",
        "react-bootstrap-typeahead": "^6.1.2",
        "react-datepicker": "^4.11.0",
        "react-dom": "^18.2.0",
        "react-hot-toast": "^2.4.0",
        "react-instantsearch": "^7.0.1",
        "react-instantsearch-dom": "^6.40.4",
        "react-simple-star-rating": "^5.1.7",
        "react-sticky-box": "^1.0.2",
        "react-tabs": "^5.2.0",
        "react-tooltip": "^5.11.1",
        "sharp": "^0.34.5",
        "striptags": "^3.2.0",
        "swiper": "^8.4.7",
        "uuid": "^8.3.2",
        "uuid-validate": "0.0.3",
        "validator": "^13.9.0"
    },
    "devDependencies": {
        "@jest/globals": "^30.3.0",
        "@playwright/test": "^1.58.0",
        "@types/react": "18",
        "@types/react-dom": "18",
        "babel-plugin-transform-remove-console": "^6.9.4",
        "eslint": "^7.29.0",
        "eslint-config-next": "14.2.0",
        "eslint-config-prettier": "^10.1.8",
        "jest": "^30.3.0",
        "next-sitemap": "^3.1.55",
        "prettier": "^3.8.1"
    }
}
